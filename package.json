{
  "name": "@vatsaldarji/react-native-audio-player",
  "version": "1.0.0",
  "description": "Audio player that plays from device and URL with customizable UI support.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    }
  },
  "keywords": [
    "react",
    "react-native",
    "typescript",
    "rn",
    "audio",
    "audio-player",
    "react-native-audio-player",
    "react-native-audio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VATSALDARJI/react-native-audio-player.git"
  },
  "author": "vatsal darji <vatsaldarji2428@gmail.com> (https://github.com/VATSALDARJI)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/VATSALDARJI/react-native-audio-player/issues"
  },
  "homepage": "https://github.com/VATSALDARJI/react-native-audio-player#readme",
  "files": [
    "src",
    "android",
    "ios",
    "lib",
    "*.podspec",
    "react-native.config.js",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "yarn clean && yarn build",
    "build:types": "tsc --project tsconfig.build.json",
    "build:commonjs": "babel src --out-dir lib/commonjs --extensions '.ts,.tsx'",
    "build:module": "babel src --out-dir lib/module --extensions '.ts,.tsx' --config-file ./babel.module.config.js",
    "build": "yarn build:types && yarn build:commonjs && yarn build:module"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "^0.78.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.2.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
